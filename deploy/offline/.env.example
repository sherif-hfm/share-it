# A private DNS name (or the server's static LAN IP), without a scheme or port.
SHAREIT_HOST=shareit.home.arpa
SHAREIT_IMAGE=shareit:offline
CADDY_IMAGE=caddy:2

# Set this to the server's LAN interface to limit the listening interface.
SHAREIT_BIND_IP=0.0.0.0
SHAREIT_HTTP_PORT=80
SHAREIT_HTTPS_PORT=443

# Change both together if this Docker subnet overlaps your LAN/VPN.
SHAREIT_SUBNET=172.30.13.0/24
SHAREIT_PROXY_IP=172.30.13.254

@inject NavigationManager Navigation
<Modal Title="Open this session as a drive." Eyebrow="READ-ONLY ACCESS" OnCancel="OnCancel" Class="mount-dialog">
    <p class="modal-description">Copy the command, paste it into your terminal, and enter the session PIN. No saved rclone connection is needed.</p>
    <div class="curl-tabs" role="group" aria-label="Operating system">
        @foreach (var option in Enum.GetValues<MountPlatform>())
        {
            <button class="small-button @(platform == option ? "selected" : "")" aria-pressed="@(platform == option ? "true" : "false")" @onclick="() => platform = option">@Label(option)</button>
        }
    </div>
    <section class="mount-step" aria-labelledby="mount-install">
        <h3 id="mount-install">1. Install once</h3>
        @if (platform == MountPlatform.Windows)
        {
            <p>Install <a href="https://rclone.org/downloads/" target="_blank" rel="noopener noreferrer">rclone</a> and <a href="https://winfsp.dev/rel/" target="_blank" rel="noopener noreferrer">WinFsp</a>.</p>
        }
        else if (platform == MountPlatform.Linux)
        {
            <p>Install <a href="https://rclone.org/downloads/" target="_blank" rel="noopener noreferrer">rclone</a> and your distribution’s FUSE 3 package, including <code>fusermount3</code>.</p>
        }
        else
        {
            <p>Install the latest <a href="https://rclone.org/downloads/" target="_blank" rel="noopener noreferrer">rclone</a>. These commands use <code>rclone nfsmount</code> with macOS’s built-in NFS client. No macFUSE installation is needed.</p>
        }
    </section>
    <section class="mount-step" aria-labelledby="mount-command">
        <h3 id="mount-command">2. Copy, paste, and enter your PIN</h3>
        @if (platform == MountPlatform.Windows)
        {
            <div class="mount-windows-note" role="note">
                <strong>Open PowerShell without “Run as administrator”.</strong>
                <p>Drives mounted as administrator may not appear in File Explorer. If your window title starts with “Administrator”, open a regular PowerShell window instead.</p>
                <p>Already mounted as administrator? Press <kbd>Ctrl</kbd> + <kbd>C</kbd> in that window before running the command again.</p>
            </div>
            <p>You can run this from the folder containing <code>rclone.exe</code>. The drive opens at <code>S:</code>. To choose another letter, copy the full command under Advanced and change <code>$shareItDrive</code>.</p>
        }
        <button class="button primary mount-copy" data-copy-value="@Command"><Icon Name="copy" Size="14" /> Copy mount command</button>
        <details class="mount-command-details"><summary>View command</summary><pre class="curl-command mount-command">@Command</pre></details>
        <p class="field-hint">Keep this terminal running. Browse the <code>texts</code> and <code>files</code> folders. Browser changes appear after the 15-second directory cache expires and you refresh or reopen the item.</p>
    </section>
    <details class="mount-step mount-command-details">
        <summary>Advanced: full command</summary>
        <p>Copy this command to inspect or customize the mount settings before running it.</p>
        <pre class="curl-command mount-command mount-full-command">@FullCommand</pre>
        <button class="small-button" data-copy-value="@FullCommand"><Icon Name="copy" Size="14" /> Copy full command</button>
    </details>
    <details class="mount-step">
        <summary>Connection details for other clients</summary>
        <dl class="mount-settings">
            <dt>URL</dt><dd><code>@DavUrl</code><button class="small-button" data-copy-value="@DavUrl" aria-label="Copy WebDAV URL"><Icon Name="copy" Size="14" /> Copy</button></dd>
            <dt>Username</dt><dd><code>@Code</code></dd>
            <dt>Password</dt><dd>This session’s four-digit PIN.</dd>
        </dl>
        <p>Use HTTPS with a trusted certificate.</p>
    </details>
    <details class="mount-step">
        <summary>Disconnect</summary>
        <p>Press <kbd>Ctrl</kbd> + <kbd>C</kbd> in the terminal running rclone.</p>
        @if (platform != MountPlatform.Windows) { <p>If the mount remains, close open files and run:</p><pre class="curl-command">@MountCommands.Unmount(Code, platform)</pre> }
        <p>The command does not save the PIN or a session connection in rclone’s configuration.</p>
    </details>
    <p class="field-hint mount-expiry">When the session ends, new server requests stop working. Files already downloaded or cached remain on your computer.</p>
</Modal>

@code {
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public EventCallback OnCancel { get; set; }
    private MountPlatform platform = MountPlatform.Windows;
    private string DavUrl => MountCommands.Url(Navigation.BaseUri, Code);
    private string Command => MountCommands.Bootstrap(Navigation.BaseUri, Code, platform);
    private string FullCommand => MountCommands.Mount(Navigation.BaseUri, Code, platform);
    private static string Label(MountPlatform value) => value == MountPlatform.MacOS ? "macOS" : value.ToString();
}

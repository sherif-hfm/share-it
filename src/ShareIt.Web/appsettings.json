{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ShareIt": { "DataPath": ".runtime" },
  "Limits": {
    "MaxFileBytes": 25000000,
    "MaxSessionFileBytes": 100000000,
    "GlobalFileBytes": 2147483648,
    "MaxFiles": 50,
    "MaxTextCards": 100,
    "MaxTextBytes": 65536,
    "MaxSessionTextBytes": 2097152,
    "MaxActiveSessions": 1000,
    "MaxCircuits": 200,
    "WebDavRequestsPerMinute": 600,
    "CleanupIntervalSeconds": 60
  }
}
